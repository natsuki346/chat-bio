<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Waitlist — Chat Bio</title>
<meta name="robots" content="noindex, nofollow">

<style>
  :root{
    --bg:#0a0a0a; --raise:#121212; --sunk:#0e0e0e;
    --line:#222; --line-2:#333;
    --text:#fff; --muted:#8c8c8c; --dim:#565656;
    --accent:#F2A623;
  }
  *{ box-sizing:border-box; margin:0; padding:0; }
  body{
    background:var(--bg); color:var(--text);
    font-family:'Inter', system-ui, -apple-system, "Hiragino Kaku Gothic ProN",
                "Noto Sans JP", sans-serif;
    font-size:15px; line-height:1.7;
    -webkit-font-smoothing:antialiased;
  }
  .wrap{ max-width:920px; margin:0 auto; padding:36px 22px 80px; }

  header{
    display:flex; align-items:center; justify-content:space-between;
    gap:14px; flex-wrap:wrap; margin-bottom:32px;
  }
  h1{ font-size:19px; font-weight:600; }
  h1 small{ display:block; font-size:12px; color:var(--dim); font-weight:400; margin-top:2px; }

  .btn{
    font-family:inherit; font-size:14px; font-weight:600;
    background:var(--accent); color:#0a0a0a;
    border:none; border-radius:999px; padding:11px 22px; cursor:pointer;
    transition:filter .2s;
  }
  .btn:hover{ filter:brightness(1.08); }
  .btn[disabled]{ opacity:.5; cursor:default; }

  .btn--ghost{
    background:none; color:var(--muted);
    border:1px solid var(--line); padding:9px 17px; font-weight:400;
  }
  .btn--ghost:hover{ color:var(--text); border-color:var(--line-2); filter:none; }

  /* ---- login ---- */
  .login{ max-width:360px; margin:80px auto 0; }
  .login h2{ font-size:17px; font-weight:600; margin-bottom:6px; }
  .login p{ font-size:13px; color:var(--dim); margin-bottom:22px; }
  label{ display:block; font-size:13px; color:var(--muted); margin:14px 0 7px; }
  input{
    width:100%; font-family:inherit; font-size:16px;
    background:var(--sunk); color:var(--text);
    border:1px solid var(--line); border-radius:10px; padding:13px 15px;
  }
  input:focus{ outline:none; border-color:var(--line-2); }
  .login .btn{ width:100%; margin-top:20px; }

  .err{ color:#ff6b6b; font-size:13px; margin-top:12px; display:none; }
  .err.show{ display:block; }

  /* ---- stats ---- */
  .stats{
    display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
    gap:1px; background:var(--line);
    border:1px solid var(--line); border-radius:13px;
    overflow:hidden; margin-bottom:14px;
  }
  .stat{ background:var(--raise); padding:17px 19px; }
  .stat b{ display:block; font-size:26px; font-weight:700; font-variant-numeric:tabular-nums; }
  .stat span{ font-size:12px; color:var(--dim); }

  /* ---- purpose breakdown ---- */
  .breakdown{
    border:1px solid var(--line); border-radius:13px;
    padding:19px; margin-bottom:26px; background:var(--raise);
  }
  .breakdown h3{ font-size:12px; color:var(--dim); font-weight:400;
                 letter-spacing:.1em; text-transform:uppercase; margin-bottom:15px; }
  .bd__row{ display:flex; align-items:center; gap:12px; margin-bottom:11px; font-size:13.5px; }
  .bd__row:last-child{ margin-bottom:0; }
  .bd__name{ width:150px; flex:none; color:var(--muted); }
  .bd__bar{ flex:1; height:5px; background:var(--sunk); border-radius:3px; overflow:hidden; }
  .bd__fill{ display:block; height:100%; background:var(--line-2); border-radius:3px; }
  .bd__n{ width:52px; text-align:right; flex:none;
          color:var(--dim); font-variant-numeric:tabular-nums; font-size:12.5px; }

  /* ---- table ---- */
  .tools{ display:flex; gap:9px; margin-bottom:14px; flex-wrap:wrap; align-items:center; }
  .tools input{ flex:1; min-width:190px; font-size:14px; padding:10px 14px; }

  .tbl{ border:1px solid var(--line); border-radius:13px; overflow:hidden; }
  .scroll{ overflow-x:auto; }
  table{ width:100%; border-collapse:collapse; font-size:13.5px; min-width:560px; }
  th{
    text-align:left; font-weight:400; font-size:11.5px; color:var(--dim);
    letter-spacing:.08em; text-transform:uppercase;
    padding:13px 16px; background:var(--raise);
    border-bottom:1px solid var(--line); white-space:nowrap;
  }
  td{ padding:13px 16px; border-bottom:1px solid var(--line); vertical-align:top; }
  tr:last-child td{ border-bottom:none; }
  td.email{ word-break:break-all; }
  td.date{ color:var(--dim); font-size:12.5px; white-space:nowrap; font-variant-numeric:tabular-nums; }
  .tag{
    display:inline-block; font-size:12px; color:var(--muted);
    border:1px solid var(--line); border-radius:999px; padding:2px 11px; white-space:nowrap;
  }

  .empty{ padding:44px 20px; text-align:center; color:var(--dim); font-size:14px; }
  .hidden{ display:none; }
  :focus-visible{ outline:2px solid var(--accent); outline-offset:3px; border-radius:4px; }
</style>
</head>

<body>
<div class="wrap">

  <!-- ============ ログイン ============ -->
  <div class="login" id="login">
    <h2>Waitlist 管理</h2>
    <p>Firebase Authentication に登録した管理者アカウントでログインしてください。</p>
    <form id="loginForm">
      <label for="u">メールアドレス</label>
      <input type="email" id="u" autocomplete="username" required>
      <label for="p">パスワード</label>
      <input type="password" id="p" autocomplete="current-password" required>
      <button type="submit" class="btn" id="loginBtn">ログイン</button>
      <p class="err" id="loginErr"></p>
    </form>
  </div>

  <!-- ============ ダッシュボード ============ -->
  <div id="dash" class="hidden">
    <header>
      <h1>Waitlist<small id="who"></small></h1>
      <div style="display:flex;gap:9px;">
        <button class="btn--ghost btn" id="csv" type="button">CSV書き出し</button>
        <button class="btn--ghost btn" id="out" type="button">ログアウト</button>
      </div>
    </header>

    <div class="stats">
      <div class="stat"><b id="nTotal">–</b><span>登録者数</span></div>
      <div class="stat"><b id="nToday">–</b><span>今日</span></div>
      <div class="stat"><b id="n7">–</b><span>直近7日</span></div>
      <div class="stat"><b id="nTop">–</b><span>最多セグメント</span></div>
    </div>

    <div class="breakdown">
      <h3>目的の内訳</h3>
      <div id="bd"></div>
    </div>

    <div class="tools">
      <input type="search" id="q" placeholder="メールアドレス・目的で絞り込む">
      <button class="btn--ghost btn" id="reload" type="button">再読み込み</button>
    </div>

    <div class="tbl">
      <div class="scroll">
        <table>
          <thead>
            <tr><th>メールアドレス</th><th>目的</th><th>登録日時</th><th>流入元</th></tr>
          </thead>
          <tbody id="rows"></tbody>
        </table>
      </div>
      <div class="empty" id="empty">読み込んでいます…</div>
    </div>
    <p class="err" id="dataErr"></p>
  </div>

</div>


<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import { getAuth, signInWithEmailAndPassword, signOut, onAuthStateChanged }
  from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
import { getFirestore, collection, getDocs, query, orderBy }
  from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

/* ============================================================
   index.html と まったく同じ firebaseConfig を貼ってください
   ============================================================ */
const firebaseConfig = {
  apiKey:            "YOUR_API_KEY",
  authDomain:        "YOUR_PROJECT.firebaseapp.com",
  projectId:         "YOUR_PROJECT_ID",
  storageBucket:     "YOUR_PROJECT.appspot.com",
  messagingSenderId: "YOUR_SENDER_ID",
  appId:             "YOUR_APP_ID"
};

const app  = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db   = getFirestore(app);

const $ = (id) => document.getElementById(id);
let rows = [];

/* ---------- auth ---------- */
$("loginForm").addEventListener("submit", async (e) => {
  e.preventDefault();
  $("loginErr").classList.remove("show");
  $("loginBtn").disabled = true;
  try {
    await signInWithEmailAndPassword(auth, $("u").value.trim(), $("p").value);
  } catch (err) {
    const m = {
      "auth/invalid-credential": "メールアドレスかパスワードが違います。",
      "auth/invalid-email":      "メールアドレスの形式が正しくありません。",
      "auth/too-many-requests":  "試行回数が多すぎます。しばらく待ってください。",
      "auth/operation-not-allowed": "コンソールでメール/パスワード認証を有効にしてください。"
    };
    $("loginErr").textContent = m[err.code] || ("ログインできませんでした（" + err.code + "）");
    $("loginErr").classList.add("show");
  } finally {
    $("loginBtn").disabled = false;
  }
});

$("out").addEventListener("click", () => signOut(auth));

onAuthStateChanged(auth, (user) => {
  if (user) {
    $("login").classList.add("hidden");
    $("dash").classList.remove("hidden");
    $("who").textContent = user.email;
    load();
  } else {
    $("dash").classList.add("hidden");
    $("login").classList.remove("hidden");
  }
});

/* ---------- data ---------- */
async function load(){
  $("dataErr").classList.remove("show");
  $("empty").textContent = "読み込んでいます…";
  $("empty").classList.remove("hidden");
  $("rows").innerHTML = "";

  try {
    const snap = await getDocs(query(collection(db, "waitlist"), orderBy("createdAt", "desc")));
    rows = snap.docs.map(d => {
      const v = d.data();
      return {
        email:    v.email    || "",
        purpose:  v.purpose  || "未回答",
        referrer: v.referrer || "direct",
        at:       v.createdAt?.toDate ? v.createdAt.toDate() : null
      };
    });
    render();
  } catch (err) {
    console.error(err);
    $("empty").classList.add("hidden");
    $("dataErr").textContent = err.code === "permission-denied"
      ? "読み取りが拒否されました。Firestore のルールで、ログイン済みユーザーの read を許可してください。"
      : "読み込みに失敗しました（" + err.code + "）";
    $("dataErr").classList.add("show");
  }
}

$("reload").addEventListener("click", load);
$("q").addEventListener("input", render);

function render(){
  const kw = $("q").value.trim().toLowerCase();
  const list = kw
    ? rows.filter(r => (r.email + " " + r.purpose).toLowerCase().includes(kw))
    : rows;

  /* stats */
  const now = new Date();
  const midnight = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  const wk = new Date(now.getTime() - 7*24*60*60*1000);

  $("nTotal").textContent = rows.length;
  $("nToday").textContent = rows.filter(r => r.at && r.at >= midnight).length;
  $("n7").textContent     = rows.filter(r => r.at && r.at >= wk).length;

  /* breakdown */
  const counts = {};
  rows.forEach(r => { counts[r.purpose] = (counts[r.purpose] || 0) + 1; });
  const sorted = Object.entries(counts).sort((a,b) => b[1] - a[1]);
  const max = sorted.length ? sorted[0][1] : 0;

  $("nTop").textContent = sorted.length ? sorted[0][0] : "–";
  if (sorted.length) $("nTop").style.fontSize = "16px";

  $("bd").innerHTML = "";
  if (!sorted.length){
    $("bd").innerHTML = '<p style="color:var(--dim);font-size:13px">まだ登録がありません。</p>';
  }
  sorted.forEach(([name, n]) => {
    const pct = rows.length ? Math.round(n / rows.length * 100) : 0;
    const row = document.createElement("div");
    row.className = "bd__row";
    row.innerHTML =
      '<span class="bd__name"></span>' +
      '<span class="bd__bar"><span class="bd__fill" style="width:' +
        (max ? n/max*100 : 0) + '%"></span></span>' +
      '<span class="bd__n">' + n + '（' + pct + '%）</span>';
    row.querySelector(".bd__name").textContent = name;
    $("bd").appendChild(row);
  });

  /* table */
  $("rows").innerHTML = "";
  if (!list.length){
    $("empty").textContent = rows.length ? "該当する登録がありません。" : "まだ登録がありません。";
    $("empty").classList.remove("hidden");
    return;
  }
  $("empty").classList.add("hidden");

  const frag = document.createDocumentFragment();
  list.forEach(r => {
    const tr = document.createElement("tr");
    tr.innerHTML =
      '<td class="email"></td><td><span class="tag"></span></td>' +
      '<td class="date"></td><td class="date"></td>';
    tr.children[0].textContent = r.email;
    tr.children[1].firstChild.textContent = r.purpose;
    tr.children[2].textContent = r.at ? fmt(r.at) : "—";
    tr.children[3].textContent = r.referrer === "direct" ? "直接" : short(r.referrer);
    frag.appendChild(tr);
  });
  $("rows").appendChild(frag);
}

function fmt(d){
  const p = (n) => String(n).padStart(2, "0");
  return d.getFullYear() + "/" + p(d.getMonth()+1) + "/" + p(d.getDate()) +
         " " + p(d.getHours()) + ":" + p(d.getMinutes());
}
function short(u){
  try { return new URL(u).hostname; } catch { return u.slice(0, 30); }
}

/* ---------- CSV ---------- */
$("csv").addEventListener("click", () => {
  if (!rows.length) return;
  const esc = (s) => '"' + String(s).replace(/"/g, '""') + '"';
  const body = rows.map(r =>
    [r.email, r.purpose, r.at ? fmt(r.at) : "", r.referrer].map(esc).join(",")
  );
  // Excel で文字化けしないよう BOM を付ける
  const csv = "\uFEFF" + ["メールアドレス,目的,登録日時,流入元", ...body].join("\r\n");

  const url = URL.createObjectURL(new Blob([csv], { type:"text/csv;charset=utf-8" }));
  const a = document.createElement("a");
  a.href = url;
  a.download = "waitlist_" + new Date().toISOString().slice(0,10) + ".csv";
  a.click();
  URL.revokeObjectURL(url);
});
</script>

</body>
</html>
